# config.env — numeros de trabajo del controlador desatendido (03.01.23)
#
# Estos numeros los fija el CEO. controlador.sh SOLO LEE este fichero, nunca lo escribe,
# y NUNCA lo hace con `source` (lo parsea linea a linea). Solo se aceptan las CUATRO
# claves de abajo, cada una como CLAVE=NUMERO, y CADA CLAVE SOLO PUEDE APARECER UNA VEZ.
# Cualquier otra clave, un valor que no sea un numero, o una clave repetida, hace que la
# cadena entera se niegue a arrancar con un error explicito.
#
# REDUCIDO por orden del CEO (04/08): ya no hay tope en dolares. Esta maquina no tiene
# clave de API (ni en el entorno ni en ningun settings.json, comprobado), corre sobre
# plan de suscripcion, y un tope en dolares no limitaba nada de verdad. Lo que SI limita
# el trabajo son los tres topes de abajo.

# Turnos agenticos maximos por sesion (flag --max-turns de claude -p).
# Minimo obligatorio: 1 (entero). 0 esta prohibido por el mismo motivo que
# TIMEOUT_SESION_SEGUNDOS de abajo: no esta verificado que este flag trate 0 como
# "ilimitado" y no es un riesgo que valga la pena correr.
MAX_TURNS=30

# Segundos maximos que se espera a que UNA sesion `claude -p` termine, envuelta en
# `timeout`. Sin esto, una sesion colgada bloquea el guion y el flock para siempre.
# 1800 = 30 minutos.
# MINIMO OBLIGATORIO: 60 segundos (entero). GNU coreutils documenta que "a duration of
# 0 disables the associated timeout": con 0 aqui, el timeout se desactiva entero
# (reproducido: con un binario que no termina nunca y timeout=0, el proceso seguia vivo
# pasados 8 segundos y hubo que matarlo con kill -9).
TIMEOUT_SESION_SEGUNDOS=1800

# Maximo de sesiones (tareas) que se encadenan en una sola tirada de controlador.sh.
# Al llegar aqui, la cadena para LIMPIA (no requiere firma del CEO: no es una anomalia,
# es el tamaño de lote). Sustituye al tope en dolares como freno de "cuanto se hace de
# un tiron sin que nadie mire". Minimo obligatorio: 1 (entero).
MAX_TAREAS_POR_TIRADA=5

# Lineas maximas que puede tener ESTADO.md, el resumen que cada sesion deja para la
# siguiente. Si se pasa, la cadena para: un traspaso que crece sin freno es el mismo
# problema de contexto acumulado que este guion existe para evitar. Minimo obligatorio:
# 1 (entero). Objetivo de diseño original: menos de 100 lineas.
MAX_LINEAS_ESTADO=100
