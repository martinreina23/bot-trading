#!/usr/bin/env bash
# Muro mecanico del proyecto. Bloquea por defecto (regla 26).
# Instalar con:  git config core.hooksPath .githooks
set -euo pipefail
fallo=0

# --- Regla 27: los datos NUNCA entran en git ---
datos=$(git diff --cached --name-only | grep -E '^02-datos/(bruto|limpio|reservado)/' | grep -v '\.gitkeep$' | grep -v 'README\.md$' || true)
if [ -n "$datos" ]; then
  echo "BLOQUEADO (regla 27): intentas commitear ficheros de datos:"
  echo "$datos" | sed 's/^/   /'
  echo "   Los datos se descargan, no se versionan. Saca esto del commit."
  fallo=1
fi

# --- Regla 22: el cajon reservado no se toca ---
res=$(git diff --cached --name-only | grep -E '^02-datos/reservado/' | grep -v 'README\.md$' || true)
if [ -n "$res" ]; then
  echo "BLOQUEADO (regla 22): tocaste el cajon reservado. Solo el CEO lo autoriza."
  fallo=1
fi

# --- Regla 21: registros que solo permiten añadir ---
for f in 04-resultados/registro-pruebas.md 00-direccion/DECISIONES.md 00-direccion/LECCIONES.md; do
  if git diff --cached --name-only | grep -qx "$f"; then
    if git diff --cached --numstat -- "$f" | awk '{ if ($2 > 0) exit 0; else exit 1 }'; then
      echo "BLOQUEADO (regla 21): $f solo admite AÑADIR, y este commit borra lineas."
      echo "   Una correccion es una entrada nueva que cita a la anterior."
      fallo=1
    fi
  fi
done

# --- Regla 13: nada de referencias a codigo por numero de linea ---
lineas=$(git diff --cached -U0 --diff-filter=ACM -- '*.md' '*.py' 2>/dev/null | grep -E '^\+' | grep -Ei '\.(py|md|json):[0-9]+' || true)
if [ -n "$lineas" ]; then
  echo "AVISO (regla 13): referencias a codigo por numero de linea. Usa el nombre del simbolo:"
  echo "$lineas" | head -5 | sed 's/^/   /'
fi

# --- Metrica L-027 (00-direccion/LECCIONES.md) sobre el WBS ---
# Toda fila de tarea del WBS (la que EMPIEZA por "| CC.CC.CC |") debe dar 7 campos
# al partirla por la barra vertical (5 columnas + 2 vacios de los bordes). Se mide
# sobre la version EN STAGE, no sobre el fichero de trabajo. Ojo: la barra vertical
# tambien aparece citada en PROSA fuera de tabla dentro del propio WBS (p.ej. en la
# explicacion de esta misma metrica); esas lineas no empiezan por "| CC.CC.CC |" y
# no deben contarse. Bloquea por defecto (regla 26 de CLAUDE.md): si no se puede leer
# el WBS en stage o la metrica falla por cualquier motivo, se bloquea el commit.
if git diff --cached --name-only | grep -qx '00-direccion/WBS.md'; then
  wbs_ok=1
  if ! wbs_stage=$(git show ':00-direccion/WBS.md' 2>&1); then
    echo "BLOQUEADO (metrica L-027): no se pudo leer 00-direccion/WBS.md en stage."
    echo "$wbs_stage" | sed 's/^/   /'
    fallo=1
    wbs_ok=0
  fi
  if [ "$wbs_ok" = "1" ]; then
    if ! malas=$(printf '%s\n' "$wbs_stage" | awk -F'|' '
        /^[ \t]*\| *[0-9][0-9]\.[0-9][0-9]\.[0-9][0-9] *\|/ {
          codigo=$2
          gsub(/^[ \t]+|[ \t]+$/, "", codigo)
          if (NF != 7) print codigo ":" NF
        }
      ' 2>&1); then
      echo "BLOQUEADO (metrica L-027): fallo al ejecutar la metrica sobre el WBS en stage."
      echo "$malas" | sed 's/^/   /'
      fallo=1
      wbs_ok=0
    fi
  fi
  if [ "$wbs_ok" = "1" ] && [ -n "$malas" ]; then
    echo "BLOQUEADO (metrica L-027): filas de tarea del WBS que no dan 7 campos al partir por '|':"
    echo "$malas" | while IFS=: read -r codigo nf; do
      echo "   tarea $codigo: $nf campos (deberian ser 7)"
    done
    fallo=1
  fi
  # Ampliacion: todo puntero expedientes/NN.NN.NN.md citado en el WBS en stage debe
  # apuntar a un fichero que exista EN EL INDICE (":00-direccion/...", stage 0), no
  # en el arbol de trabajo. Esto acepta un expediente nuevo anadido en el mismo commit
  # que lo referencia, sin exigir que ya estuviera en HEAD.
  if [ "$wbs_ok" = "1" ]; then
    faltan=$(printf '%s\n' "$wbs_stage" | grep -oE 'expedientes/[0-9]{2}\.[0-9]{2}\.[0-9]{2}\.md' | sort -u | while read -r p; do git cat-file -e ":00-direccion/$p" 2>/dev/null || echo "$p"; done) || true
    if [ -n "$faltan" ]; then
      echo "BLOQUEADO (ampliacion L-027): punteros a expedientes que no existen en este commit:"
      echo "$faltan" | sed 's#^#   00-direccion/#'
      fallo=1
    fi
  fi
fi

# --- Regla 1: el mensaje debe llevar codigo WBS (lo valida commit-msg) ---
exit $fallo
